CC = @CC@
CFLAGS = @CFLAGS@ -MMD -MP
LIBS = @LIBS@
RM = @RM@
BUILD_RV64 = @BUILD_RV64@

TARGET = ../msim

include files.mk

SOURCES = $(MSIM_SOURCES)

ifeq ($(BUILD_RV64),yes)
CFLAGS += -DBUILD_RV64=1
else
CFLAGS += -DBUILD_RV64=0
endif

OBJECTS := $(addsuffix .o,$(basename $(SOURCES)))
DEPS := $(OBJECTS:.o=.d)

.PHONY: all clean distclean rvtest

all: $(TARGET)

clean:
	$(RM) -f $(TARGET) $(OBJECTS) $(DEPS)

distclean: clean
	$(RM) -f Makefile

-include $(DEPS)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $(OBJECTS) $(LIBS)

%.o: %.c
	$(CC) -c $(CFLAGS) -o $@ $<

rvtest: all
	$(MAKE) -C ../tests/rvtests/unit-tests test
