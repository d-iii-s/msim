CC = @CC@
CFLAGS = @CFLAGS@ -MMD -MP
LIBS = @LIBS@
RM = @RM@
BUILD_RV64 = @BUILD_RV64@

TARGET = ../msim

SOURCES_COMMON = \
	utils.c \
	fault.c \
	text.c \
	env.c \
	cmd.c \
	main.c \
	parser.c \
	list.c \
	input.c \
	physmem.c \
	debug/debug.c \
	debug/gdb.c \
	debug/breakpoint.c \
	debug/dap.c \
	device/cpu/mips_r4000/cpu.c \
	device/cpu/mips_r4000/debug.c \
	device/cpu/riscv_rv32ima/cpu.c \
	device/cpu/riscv_rv32ima/csr.c \
	device/cpu/riscv_rv32ima/instr.c \
	device/cpu/riscv_rv32ima/tlb.c \
	device/cpu/riscv_rv32ima/mnemonics.c \
	device/cpu/riscv_rv32ima/debug.c \
	device/cpu/general_cpu.c \
	device/mem.c \
	device/ddisk.c \
	device/dr4kcpu.c \
	device/drvcpu.c  \
	device/dcycle.c \
	device/dkeyboard.c \
	device/dlcd.c \
	device/dnomem.c \
	device/dorder.c \
	device/dprinter.c \
	device/dtime.c \
	device/device.c \
	arch/win32/mmap.c \
	arch/win32/stdin.c \
	arch/win32/signal.c \
	arch/posix/stdin.c \
	arch/posix/signal.c

SOURCES_RV64 = \
	device/cpu/riscv_rv64ima/cpu.c \
	device/cpu/riscv_rv64ima/csr.c \
	device/cpu/riscv_rv64ima/instr.c \
	device/cpu/riscv_rv64ima/tlb.c \
	device/cpu/riscv_rv64ima/debug.c \
	device/cpu/riscv_rv64ima/mnemonics.c \
	device/drv64cpu.c

ifeq ($(BUILD_RV64),yes)
SOURCES = $(SOURCES_COMMON) $(SOURCES_RV64)
CFLAGS += -DBUILD_RV64=1
else
SOURCES = $(SOURCES_COMMON)
CFLAGS += -DBUILD_RV64=0
endif

OBJECTS := $(addsuffix .o,$(basename $(SOURCES)))
DEPS := $(OBJECTS:.o=.d)

export MSIM_OBJECTS = $(OBJECTS)
export MSIM_LIBS = $(LIBS)

.PHONY: all clean distclean rvtest

all: $(TARGET)

clean:
	$(RM) -f $(TARGET) $(OBJECTS) $(DEPS)

distclean: clean
	$(RM) -f Makefile

-include $(DEPS)

$(TARGET): $(OBJECTS)
	$(CC) $(CFLAGS) -o $@ $(OBJECTS) $(LIBS)

%.o: %.c
	$(CC) -c $(CFLAGS) -o $@ $<

rvtest: all
	$(MAKE) -C ../tests/rvtests/unit-tests test
